# Local-only artifacts — never published.
node_modules/
dist/
.cache/
*.local.json
python/.venv/
python/**/__pycache__/
.pytest_cache/

# Derived projections. Regenerating them is cheap; committing a full regenerated
# graph on every run is exactly the daily-snapshot bloat PROBLEM.md section 9
# forbids. Anchored with a leading slash: an unanchored `artifacts/` would also
# match `src/artifacts/`. Nothing here is authoritative — `bun run graph` rebuilds it.
/artifacts/

# Built site. Regenerated by `bun run site`; deploying it is a separate,
# deliberate operator decision, not a side effect of a build.
/site/

# Private view: per-person scores and rankings stay off the public repo.
/private/

# Transient working files, per the workspace convention. Never force-added.
/.git-ignored/

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
