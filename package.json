{
  "name": "laocoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structural engagement measures for IETF mailing list discussions.",
  "scripts": {
    "codegen": "bun run src/cli/codegen.ts",
    "ingest": "bun run src/cli/ingest.ts",
    "graph": "bun run src/cli/graph.ts",
    "stats": "bun run src/cli/stats.ts",
    "test": "bun test",
    "test:py": "uv run --directory python --with pytest pytest tests -q",
    "check": "tsc --noEmit && bun --cwd web run typecheck && bun test && uv run --directory python --with pytest pytest tests -q",
    "typecheck": "tsc --noEmit",
    "resolve": "bun run src/cli/resolve.ts",
    "reputation": "bun run src/cli/reputation.ts",
    "seed": "bun run src/cli/seed.ts",
    "classify": "bun run src/cli/classify.ts",
    "measure": "bun run src/cli/measure.ts",
    "holdout": "bun run src/cli/holdout.ts",
    "agreement": "bun run src/cli/agreement.ts",
    "site": "bun run src/cli/site.ts",
    "private-view": "bun run src/cli/private-view.ts",
    "private-serve": "bun run src/cli/private-view.ts --serve",
    "web:typecheck": "bun --cwd web run typecheck",
    "activity": "bun run src/cli/activity.ts",
    "stewards": "bun run src/cli/stewards.ts",
    "embed": "bun run src/cli/embed.ts",
    "topics": "bun run src/cli/topics.ts",
    "name-topics": "bun run src/cli/name-topics.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mailparser": "^3.9.15",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/mailparser": "^3.4.6",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2"
  }
}
